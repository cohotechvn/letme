<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cohotech" model="ir.module.category">
        <field name="name">COHOTECH</field>
        <field name="sequence">1</field>
    </record>

    <!-- Technical restriction: sale orders of other salespeople are read-only and hidden. -->
    <record id="privilege_own_orders" model="res.groups.privilege">
        <field name="name">Sale Order Visibility</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="module_category_cohotech"/>
        <field name="placeholder">Per Sales rights</field>
    </record>

    <record id="group_own_orders_only" model="res.groups">
        <field name="name">Own Sale Orders Only</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_own_orders"/>
        <field name="comment">Hides and protects sale orders of other salespeople, even when Inventory or Point of Sale rights would allow them. Ignored for users with Sales "All Documents" rights.</field>
    </record>

    <!-- One role per employee. A role only adds the standard rights listed in implied_ids. -->
    <record id="privilege_role" model="res.groups.privilege">
        <field name="name">COHOTECH Role</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_cohotech"/>
        <field name="placeholder">No role</field>
    </record>

    <record id="group_role_sales" model="res.groups">
        <field name="name">Salesperson</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_role"/>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman')),
            (4, ref('point_of_sale.group_pos_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('group_own_orders_only')),
        ]"/>
    </record>

    <record id="group_role_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_role"/>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman')),
            (4, ref('point_of_sale.group_pos_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('group_own_orders_only')),
        ]"/>
    </record>

    <record id="group_role_warehouse" model="res.groups">
        <field name="name">Warehouse and Purchasing</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_role"/>
        <field name="implied_ids" eval="[
            (4, ref('stock.group_stock_user')),
            (4, ref('purchase.group_purchase_user')),
        ]"/>
    </record>

    <record id="group_role_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_role"/>
        <field name="implied_ids" eval="[
            (4, ref('account.group_account_manager')),
            (4, ref('hr_attendance.group_hr_attendance_manager')),
            (4, ref('hr_holidays.group_hr_holidays_manager')),
        ]"/>
    </record>

    <record id="group_role_store_manager" model="res.groups">
        <field name="name">Store Manager</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="privilege_role"/>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('point_of_sale.group_pos_manager')),
            (4, ref('stock.group_stock_manager')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('account.group_account_invoice')),
            (4, ref('hr_attendance.group_hr_attendance_user')),
            (4, ref('hr_holidays.group_hr_holidays_user')),
        ]"/>
    </record>

    <record id="group_role_director" model="res.groups">
        <field name="name">Director</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="privilege_role"/>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('point_of_sale.group_pos_manager')),
            (4, ref('stock.group_stock_manager')),
            (4, ref('purchase.group_purchase_manager')),
            (4, ref('account.group_account_manager')),
            (4, ref('hr.group_hr_manager')),
            (4, ref('hr_attendance.group_hr_attendance_manager')),
            (4, ref('hr_holidays.group_hr_holidays_manager')),
        ]"/>
    </record>
</odoo>
